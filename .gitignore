# dependencies
node_modules/
.pnpm-store/

# secrets
.env
.env.*
!.env.example

# build
dist/
build/
*.tsbuildinfo

# data — regenerate from seeds, never commit
*.db
*.sqlite
*.sqlite3
data/*.db

