# os / editor
.DS_Store
.idea/
*.swp

# eval findings — may contain conversation text
eval-findings/

# day-10 idempotency store (runtime state)
.idempotency.json

# day-11 memory store (runtime state, and personal data)
.memory.db

# day-12 escalation queue (runtime state, and personal data)
.queue.db

# day-13 trace store (runtime state, and personal data)
.traces.db


# day-14 rate limit store (runtime state)
.limits.db
.agent-disabled
