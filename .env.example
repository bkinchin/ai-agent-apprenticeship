# Copy to .env and fill in. .env is gitignored — never commit real keys.

OPENAI_API_KEY=sk-...

# Pin the model version explicitly. A floating alias means your production
# behaviour changes when the provider ships an update — no deploy, no notice.
# See curriculum/week-03/day-20.md.
OPENAI_MODEL=gpt-4.1-2025-04-14

# Cost and safety limits (days 3, 20)
MAX_AGENT_STEPS=8
MAX_CONVERSATION_COST_GBP=0.50

# Storage
DATABASE_PATH=./data/apprenticeship.db

# Observability (day 13)
TRACE_ENABLED=true
TRACE_PATH=./traces
LOG_LEVEL=info
