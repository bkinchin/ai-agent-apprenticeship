# Copy to .env.local (or .env) and fill in. Both are gitignored —
# never commit real keys.

ANTHROPIC_API_KEY=sk-ant-...

# Pin the model explicitly in anything you measure. A model that changes
# underneath you changes your behaviour with no deploy and no notice.
# See curriculum/week-03/day-20.md.
ANTHROPIC_MODEL=claude-haiku-4-5

# Cheaper model for classification, routing, and LLM judges (day 7).
# Reserve the expensive model for reasoning that needs it.
ANTHROPIC_MODEL_CHEAP=claude-haiku-4-5

# Cost and safety limits (days 3, 20)
MAX_AGENT_STEPS=8
MAX_CONVERSATION_COST_GBP=0.50

# Storage
DATABASE_PATH=./data/apprenticeship.db

# Observability (day 13)
TRACE_ENABLED=true
TRACE_PATH=./traces
LOG_LEVEL=info

# Optional. Which model runs the AGENT (~92% of the cost of a conversation).
# Defaults to claude-haiku-4-5, which is what both projects' baselines were
# measured on. Set to claude-opus-5 when you want the more capable model;
# every report names the model that produced it.
#   ANTHROPIC_MODEL=claude-opus-5
#
# The guards are a SEPARATE variable, because they were calibrated on Haiku
# (16/16 escalation, 16/16 judge) and changing them invalidates those numbers.
#   ANTHROPIC_GUARD_MODEL=claude-haiku-4-5
